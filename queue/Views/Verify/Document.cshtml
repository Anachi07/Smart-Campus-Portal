@model DocumentVerification
@{Layout=null;}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Document verification · ICAS Campus</title><link rel="stylesheet" href="/css/site.css"><link rel="stylesheet" href="/css/operations.css"><link rel="stylesheet" href="/accessibility/preferences.css"><script src="/accessibility/preferences.js"></script>
</head><body><main class="content-shell narrow"><section class="panel"><p class="eyebrow">DOCUMENT REGISTRY</p><h1>@(Model.RevokedAt.HasValue?"Registration revoked":"Registered document")</h1><h2>@Model.Title</h2><p>Issuer: @Model.Issuer</p><p>Registered: @Model.IssuedAt.ToString("MMM d, yyyy h:mm tt") · Manila</p>@if(Model.RevokedAt.HasValue){<p role="alert">Revoked @Model.RevokedAt.Value.ToString("MMM d, yyyy h:mm tt") · Manila. Contact the issuing school.</p>}<p>This page confirms a registry entry for the exact file fingerprint below. A copied QR on a different file does not authenticate that file. Student names and records are not displayed publicly.</p><label for="fingerprint">Registered SHA-256 fingerprint</label><textarea id="fingerprint" readonly rows="3">@Model.Sha256</textarea><h2>Check your PDF locally</h2><p>The selected file stays on your device. Compare it with the school's registered file.</p><label for="verify-file">Choose PDF<input id="verify-file" type="file" accept=".pdf,application/pdf" data-document-hash="@Model.Sha256" data-document-revoked="@(Model.RevokedAt.HasValue?"true":"false")"></label><p data-document-result role="status"></p><a href="/">Campus home</a></section></main><script src="/js/verify-document.js"></script></body></html>
