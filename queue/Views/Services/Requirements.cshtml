@model List<ServiceRequirement>
@{ViewData["Title"]="Service requirements";}
<section class="admin-layout">@await Html.PartialAsync("_AdminSidebar")<div class="admin-main">
<div class="section-head"><div><p class="eyebrow">SCHOOL-MANAGED GUIDANCE</p><h1>Requirements checklist</h1><p class="muted">Publish requirements approved by the responsible office. Changes apply to new requests; existing checklists keep their original instructions.</p></div></div>
@if(ViewBag.Message!=null){<div class="alert alert-info" role="status">@ViewBag.Message</div>}
<section class="panel"><h2>Add a requirement</h2><form asp-action="SaveRequirement" method="post" class="ops-form-grid"><label>Service<select name="ServiceType" id="requirement-service">@foreach(var service in CampusServices.RequestTypes.Keys){<option>@service</option>}</select></label><label>Transaction<select name="RequestType" id="requirement-type">@foreach(var type in CampusServices.RequestTypes.First().Value){<option>@type</option>}</select></label><label>Requirement title<input name="Title" maxlength="120" required placeholder="Enter a school-approved requirement"/></label><label>Instructions<textarea name="Instructions" maxlength="600" rows="2"></textarea></label><label class="ops-check"><input type="checkbox" name="Required" value="true" checked/><input type="hidden" name="Required" value="false"/><span>Required before document readiness</span></label><input type="hidden" name="Active" value="true"/><button class="btn" type="submit">Publish requirement</button></form></section>
@if(!Model.Any()){<section class="panel"><p class="muted">No requirements configured. Students are directed to ask the office until approved requirements are published.</p></section>}
@foreach(var requirement in Model){<section class="panel"><p class="eyebrow">@requirement.ServiceType · @requirement.RequestType</p><form asp-action="SaveRequirement" method="post" class="ops-form-grid"><input type="hidden" name="Id" value="@requirement.Id"/><input type="hidden" name="ServiceType" value="@requirement.ServiceType"/><input type="hidden" name="RequestType" value="@requirement.RequestType"/><label>Requirement title<input name="Title" value="@requirement.Title" maxlength="120" required/></label><label>Instructions<textarea name="Instructions" maxlength="600" rows="2">@requirement.Instructions</textarea></label><label class="ops-check"><input type="checkbox" name="Required" value="true" checked="@requirement.Required"/><input type="hidden" name="Required" value="false"/><span>Required</span></label><label class="ops-check"><input type="checkbox" name="Active" value="true" checked="@requirement.Active"/><input type="hidden" name="Active" value="false"/><span>Published for new requests</span></label><button class="btn btn-soft" type="submit">Save requirement</button></form></section>}
</div></section>
@section Scripts{<script>const types=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(CampusServices.RequestTypes));document.getElementById('requirement-service').addEventListener('change',event=>{document.getElementById('requirement-type').replaceChildren(...types[event.target.value].map(type=>new Option(type,type)));});</script>}
