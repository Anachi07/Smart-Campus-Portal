@model RequestDetailViewModel
@if(Model.Ticket.ServiceType=="Document Request"){
<section class="panel"><h2>Issued document registry</h2><p class="muted">The Registrar registers the final school-issued PDF here. Requirement submissions and claim stubs are not issued academic documents.</p>
@foreach(var doc in Model.IssuedDocuments){<article class="submission-item"><h3>@doc.Title · @(doc.RevokedAt.HasValue?"Revoked":"Registered")</h3><p>@doc.IssuedAt.ToString("MMM d, yyyy h:mm tt") · Manila</p><div class="actions"><a class="btn btn-soft" asp-action="IssuedFile" asp-route-documentId="@doc.Id">Download issued PDF</a><a class="btn btn-soft" href="/Verify/Document?code=@doc.Code">Open verification page</a></div><img src="/Services/IssuedQr?id=@Uri.EscapeDataString(Model.Ticket.TicketNumber)&documentId=@doc.Id" width="180" height="180" alt="Verification QR for registered document"/>
@if(Model.Staff&&!doc.RevokedAt.HasValue){<form asp-action="RevokeIssued" method="post"><input type="hidden" name="id" value="@Model.Ticket.TicketNumber"><input type="hidden" name="documentId" value="@doc.Id"><label>Reason for revoking this registration<textarea name="note" minlength="5" maxlength="600" required></textarea></label><button class="btn btn-soft">Revoke registration</button></form>}</article>}
@if(Model.Staff&&Model.Ticket.DocumentStatus is "Ready for pickup" or "Released"&&!Model.IssuedDocuments.Any(d=>!d.RevokedAt.HasValue)){
<form asp-action="RegisterIssued" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@Model.Ticket.TicketNumber"><label>Final school-issued PDF (up to 2 MB)<input type="file" name="file" accept=".pdf,application/pdf" required></label><p class="muted">Register only an authorized final document. Registration does not sign a PDF or verify the recipient's identity.</p><button class="btn">Register issued PDF</button></form>}
</section>}
