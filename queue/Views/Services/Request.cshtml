@model RequestDetailViewModel
@{var t=Model.Ticket;ViewData["Title"]="Request "+t.TicketNumber;var stage=Array.IndexOf(QueueStore.DocumentStages,t.DocumentStatus??"");var owner=t.CustomerUserId==Context.Session.GetInt32("UserId");var closed=QueueStore.ChecklistClosed(t);}
<section class="content-shell ops-detail">
<div class="section-head"><div><p class="eyebrow">@t.Office · @t.TicketNumber</p><h1>@t.RequestType</h1><p class="muted">Queue: @t.Status · @(t.DocumentStatus??"Office transaction")</p></div><a class="btn btn-soft" href="/Services/Requests">All requests</a></div>
@if(Model.Message!=null){<div class="alert alert-info" role="status">@Model.Message</div>}
@if(t.DocumentStatus!=null){<ol class="ops-timeline" aria-label="Document progress">@for(var i=0;i<QueueStore.DocumentStages.Length;i++){<li class="@(i<=stage?"reached":"")"><span>@(i+1)</span>@QueueStore.DocumentStages[i]</li>}</ol><p class="muted">Queue service and document release are tracked separately. The Registrar confirms eligibility and actual release.</p>}
<div class="two-col">
<section class="panel"><h2>Prepare for your visit</h2><p class="muted">Your checks mean you have prepared an item. Only the office can mark it verified.</p>
@if(!t.Checklist.Any()){<p class="ops-empty">No school requirements have been listed for this request. Ask the @t.Office before visiting; requirements may still apply.</p>}else{
<form asp-action="Prepared" method="post"><input type="hidden" name="id" value="@t.TicketNumber"/>
@foreach(var item in t.Checklist){<label class="ops-check"><input type="checkbox" name="prepared" value="@item.RequirementId" checked="@item.Prepared" disabled="@(!owner||closed)"/><span><strong>@item.Title @(item.Required?"(required)":"(optional)")</strong><small>@item.Instructions</small><small class="@(item.Verified?"ops-verified":"")">Office: @(item.Verified?"Verified":"Not yet verified")</small></span></label>}
@if(owner&&!closed){<button class="btn btn-soft" type="submit">Save my checklist</button>}</form>}
</section>
<section class="panel"><h2>Visit & collection</h2><p><strong>@t.CustomerName</strong><br/>Student / reference: @t.StudentNumber</p>@if(t.ScheduledAt.HasValue){<p>Reserved visit: @t.ScheduledAt.Value.ToString("MMM d, yyyy h:mm tt") · Manila</p>}
<p class="muted">@t.RequestNotes</p><div class="actions"><a class="btn btn-soft" href="/Queue/Ticket?id=@Uri.EscapeDataString(t.TicketNumber)">Queue ticket</a><button class="btn btn-soft" type="button" data-assistant-action="bookings">Manage visit</button></div>
@if(t.DocumentStatus is "Ready for pickup" or "Released"){<p class="ops-ready">Your claim stub is available. Follow the Registrar's collection instructions.</p><a class="btn" asp-action="Claim" asp-route-id="@t.TicketNumber">View / print claim stub</a>}
<p class="muted">In-app reminders appear while this service is running. Check the office calendar before visiting. No SMS or email delivery is connected.</p><a href="/Services/OfficeCalendar">View office closures →</a></section>
</div>
@if(Model.Staff){<section class="panel"><p class="eyebrow">OFFICE WORKSPACE</p><h2>Review this request</h2><p class="muted">Verify actual requirements. Confirming release also completes an active waiting/serving queue visit. Progress notes are visible to the requester; do not include sensitive identity or payment details.</p>
@if(t.Checklist.Any()){<form asp-action="Verify" method="post"><input type="hidden" name="id" value="@t.TicketNumber"/><fieldset><legend>Office verification</legend>@foreach(var item in t.Checklist){<label class="ops-check"><input type="checkbox" name="verified" value="@item.RequirementId" checked="@item.Verified"/><span>@item.Title</span></label>}</fieldset><button class="btn btn-soft" type="submit">Save office verification</button></form>}
@if(t.DocumentStatus!=null&&stage>=0&&stage<QueueStore.DocumentStages.Length-1&&!closed){<form asp-action="Progress" method="post" class="ops-progress-form"><input type="hidden" name="id" value="@t.TicketNumber"/><label>Next document stage<select name="stage"><option>@QueueStore.DocumentStages[stage+1]</option></select></label><label>Note for the requester<textarea name="note" maxlength="600" rows="2" required="@(stage==2)" placeholder="Pickup instructions or release confirmation"></textarea></label><button class="btn" type="submit">Confirm document update</button></form>}
</section>}
@if(t.DocumentHistory.Any()){<section class="panel"><h2>Progress history</h2>@foreach(var item in t.DocumentHistory.OrderByDescending(h=>h.At)){<article class="ops-history"><strong>@item.Status</strong><small>@item.At.ToString("MMM d, yyyy h:mm tt") · Manila</small><p>@item.Note</p></article>}</section>}
@if(owner){<section class="panel"><h2>How was your transaction?</h2>@if(Model.Feedback!=null){<p>Thank you. Your rating: <strong>@Model.Feedback.Rating / 5</strong></p><p>@Model.Feedback.Comment</p>}else if(Model.CanFeedback){<form asp-action="Feedback" method="post"><input type="hidden" name="id" value="@t.TicketNumber"/><label>Service rating<select name="rating" required><option value="">Choose a rating</option>@for(var i=5;i>=1;i--){<option value="@i">@i / 5</option>}</select></label><label>Comment (optional)<textarea name="comment" maxlength="500" rows="3" placeholder="Tell the office what went well or needs improvement. Do not include passwords or payment details."></textarea></label><button class="btn" type="submit">Submit feedback privately</button></form>}else{<p class="muted">Feedback opens after your transaction is completed. For documents, wait until the Registrar confirms release.</p>}</section>}
</section>
