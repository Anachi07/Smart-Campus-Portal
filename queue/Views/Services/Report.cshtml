@model OperationsReport
@{ViewData["Title"]="Campus service reports";}
<section class="admin-layout">@await Html.PartialAsync("_AdminSidebar")<div class="admin-main">
<div class="section-head"><div><p class="eyebrow">SERVICE PERFORMANCE</p><h1>Campus service reports</h1><p class="muted">Current outcomes for requests created within the selected date range.</p></div><div class="actions no-print"><button class="btn btn-soft" type="button" onclick="window.print()">Print</button><a class="btn" asp-action="Report" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" asp-route-office="@Model.Office" asp-route-export="csv">Export summary CSV</a></div></div>
<form method="get" class="panel ops-filter no-print"><label>From<input name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" required/></label><label>To<input name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" required/></label><label>Office<select name="office">@foreach(var office in QueueStore.Offices){<option selected="@(Model.Office==office)">@office</option>}</select></label><button class="btn" type="submit">Apply filters</button></form>
<div class="stat-grid"><div class="stat-card"><span>Requests</span><strong>@Model.Requests</strong></div><div class="stat-card"><span>Completed visits</span><strong>@Model.CompletedVisits</strong></div><div class="stat-card"><span>Average actual wait</span><strong>@(Model.AverageWaitMinutes?.ToString("0.0")??"—")</strong><small>minutes · @Model.WaitSamples called visits</small></div><div class="stat-card"><span>Documents released</span><strong>@Model.ReleasedDocuments</strong></div><div class="stat-card"><span>Service rating</span><strong>@(Model.AverageRating?.ToString("0.00")??"—")</strong><small>/ 5 · @Model.FeedbackCount responses</small></div></div>
<p class="muted">Wait is measured from arrival/check-in to counter call, using recorded times only. Uncalled visits do not count as zero wait. Feedback and document outcomes relate to requests created in this period, even if completed later. Dates use Manila time.</p>
<div class="two-col"><section class="panel"><h2>Most requested transactions</h2>@if(!Model.Transactions.Any()){<p class="muted">No requests in this period.</p>}@foreach(var row in Model.Transactions){<div class="ops-metric"><span>@row.Label</span><strong>@row.Count</strong></div>}</section><section class="panel"><h2>Document progress</h2>@if(!Model.DocumentStatuses.Any()){<p class="muted">No document requests in this period.</p>}@foreach(var row in Model.DocumentStatuses){<div class="ops-metric"><span>@row.Label</span><strong>@row.Count</strong></div>}</section></div>
<section class="panel"><h2>Queue outcomes</h2>@foreach(var row in Model.QueueStatuses){<div class="ops-metric"><span>@row.Label</span><strong>@row.Count</strong></div>}</section>
<section class="panel"><h2>Private service feedback</h2><p class="muted">Visible to authorized office staff only. Most recent 100 responses for this request cohort; feedback is optional.</p>@if(!Model.Feedback.Any()){<p class="muted">No feedback submitted yet.</p>}@foreach(var feedback in Model.Feedback){<article class="ops-history"><strong>@feedback.Rating / 5 · @feedback.TicketNumber</strong><small>@feedback.SubmittedAt.ToString("MMM d, yyyy h:mm tt") · Manila</small><p>@feedback.Comment</p></article>}</section>
</div></section>
