@model List<OfficeClosure>
@{ViewData["Title"]="Office calendar";bool staff=ViewBag.Staff==true;AppSettings settings=ViewBag.Settings;}
<section class="@(staff?"admin-layout":"content-shell")">@if(staff){@await Html.PartialAsync("_AdminSidebar")}<div class="@(staff?"admin-main":"")">
<div class="section-head"><div><p class="eyebrow">REGISTRAR & CASHIER</p><h1>Office calendar</h1><p class="muted">Booking hours and office closures · All times are in Manila time.</p></div><a class="btn btn-soft" href="/Services/Requests">Service requests</a></div>
@if(ViewBag.Message!=null){<div class="alert alert-info" role="status">@ViewBag.Message</div>}
<section class="panel"><h2>Current booking hours</h2><p>@string.Join(", ",settings.BookingDays.OrderBy(d=>d).Select(d=>((DayOfWeek)d).ToString())) · @settings.BusinessStartHour.ToString("00"):00–@settings.BusinessEndHour.ToString("00"):00</p><p class="muted">These hours are configured by the office. Closures below override availability. A reserved visit does not guarantee immediate service.</p></section>
@if(staff){<section class="panel"><h2>Add holiday, lunch break, or unavailable time</h2><p class="muted">Affected reservation holders receive an in-app notice. Their visits are preserved and can be moved to an available time, including when a closure is announced close to arrival.</p><form asp-action="AddClosure" method="post" class="ops-form-grid"><label>Office<select name="Office">@foreach(var office in QueueStore.Offices){<option>@office</option>}</select></label><label>Title<input name="Title" maxlength="120" required placeholder="Office-approved closure reason"/></label><label>Recurrence<select name="Mode"><option value="Date">Specific date</option><option value="Weekly">Weekly break</option></select></label><label>Date (specific date only)<input type="date" name="Date"/></label><label>Weekly day (weekly break only)<select name="Weekday"><option value="">Every day</option>@for(var i=0;i<7;i++){<option value="@i">@((DayOfWeek)i)</option>}</select></label><label class="ops-check"><input type="checkbox" name="AllDay" value="true"/><span>Closed all day</span></label><label>Start<input type="time" name="StartTime" value="12:00" required/></label><label>End<input type="time" name="EndTime" value="13:00" required/></label><button class="btn" type="submit">Save office closure</button></form></section>}
<section class="panel"><h2>Closures & recurring breaks</h2>@if(!Model.Any()){<p class="muted">No office closures have been published. Ask the office to confirm holiday availability.</p>}@foreach(var closure in Model){<article class="ops-closure"><div><span class="eyebrow">@closure.Office</span><h3>@closure.Title</h3><p>@(closure.Date.HasValue?closure.Date.Value.ToString("MMM d, yyyy"):closure.Weekday.HasValue?"Every "+((DayOfWeek)closure.Weekday.Value):"Every day") · @(closure.AllDay?"All day":closure.StartTime+"–"+closure.EndTime)</p></div>@if(staff){<form asp-action="RemoveClosure" method="post"><input type="hidden" name="id" value="@closure.Id"/><button class="btn btn-soft" type="submit">Remove closure</button></form>}</article>}</section>
</div></section>
