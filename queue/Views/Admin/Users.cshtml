@model UserManagementViewModel
@{
    ViewData["Title"] = "Accounts";
}
<div class="admin-layout">
    <partial name="_AdminSidebar" />
    <section class="admin-main">
        <div class="section-head reveal-up">
            <div>
                <p class="eyebrow">Accounts</p>
                <h1>User Management</h1>
                <p class="muted">Create staff access and manage customer accounts.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(ViewBag.SuccessMessage as string))
        {
            <div class="alert alert-success">@ViewBag.SuccessMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-error">@Model.ErrorMessage</div>
        }

        <div class="panel reveal-up delay-1">
            <div class="panel-head"><h2>Add Admin or Staff</h2><span>Admin only</span></div>
            <form asp-action="AddUser" method="post" class="form-grid" autocomplete="off">
                @Html.AntiForgeryToken()
                <label>Full Name
                    <input asp-for="FullName" placeholder="Full name" required />
                </label>
                <label>Phone Number
                    <input asp-for="PhoneNumber" placeholder="09XXXXXXXXX" inputmode="numeric" maxlength="11" pattern="09[0-9]{9}" required />
                </label>
                <label>Username
                    <input asp-for="Username" placeholder="Username" autocomplete="new-password" required />
                </label>
                <label>Role
                    <select asp-for="Role" required>
                        <option>Staff</option>
                        <option>Admin</option>
                    </select>
                </label>
                <label>Password
                    <input asp-for="Password" type="password" placeholder="Minimum 6 characters" autocomplete="new-password" required />
                </label>
                <label>Confirm Password
                    <input asp-for="ConfirmPassword" type="password" placeholder="Re-enter password" autocomplete="new-password" required />
                </label>
                <button class="btn btn-animated span-2" type="submit">Create Account</button>
            </form>
        </div>

        <div class="panel reveal-up delay-2">
            <div class="panel-head"><h2>Admin and Staff</h2><span>@Model.AdminStaffUsers.Count account(s)</span></div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Name</th><th>Username</th><th>Phone</th><th>Role</th><th>Created</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var user in Model.AdminStaffUsers)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@QueueStore.MaskUsername(user.Username)</td>
                            <td>@QueueStore.MaskPhone(user.PhoneNumber)</td>
                            <td><span class="pill status-priority">@user.Role</span></td>
                            <td>@user.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td>
                                <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Delete this account?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button class="btn btn-small btn-soft" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel reveal-up delay-3">
            <div class="panel-head"><h2>Customers</h2><span>@Model.CustomerUsers.Count account(s)</span></div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Name</th><th>Username</th><th>Phone</th><th>Role</th><th>Created</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var user in Model.CustomerUsers)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@QueueStore.MaskUsername(user.Username)</td>
                            <td>@QueueStore.MaskPhone(user.PhoneNumber)</td>
                            <td><span class="pill">Customer</span></td>
                            <td>@user.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td>
                                <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Delete this customer account?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button class="btn btn-small btn-soft" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
