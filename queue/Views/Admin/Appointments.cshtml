@model List<Ticket>
@{ViewData["Title"]="Scheduled visits";}
<section class="admin-layout">@await Html.PartialAsync("_AdminSidebar")<div class="admin-main"><div class="section-head"><div><p class="eyebrow">REGISTRAR & CASHIER</p><h1>Scheduled visits</h1><p class="muted">Upcoming reservations. Students check in on arrival before joining the service queue.</p></div><a class="btn btn-soft" asp-action="Settings">Booking rules</a></div><div class="panel"><div class="table-wrap"><table><thead><tr><th>Visit · Manila</th><th>Ticket</th><th>Office</th><th>Requested by</th><th>Transaction</th><th>Details</th></tr></thead><tbody>@foreach(var ticket in Model){<tr><td>@ticket.ScheduledAt?.ToString("MMM dd, yyyy hh:mm tt")</td><td>@ticket.TicketNumber</td><td>@ticket.Office</td><td>@ticket.CustomerName</td><td>@ticket.RequestType</td><td><a class="btn btn-small btn-soft" asp-controller="Queue" asp-action="Ticket" asp-route-id="@ticket.TicketNumber">View</a></td></tr>}@if(!Model.Any()){<tr><td colspan="6">No upcoming reservations.</td></tr>}</tbody></table></div></div></div></section>
