@using Microsoft.AspNetCore.Http
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var role = Context.Session.GetString("Role") ?? string.Empty;
    string Active(string name) => action == name ? "active" : string.Empty;
}
<aside class="sidebar" aria-label="Admin navigation">
    <div class="sidebar-brand sidebar-brand-icon-only">
        <img class="sidebar-logo" src="~/img/smartqueue-logo-icon-only.svg" alt="SmartQueueSystemGUI logo" />
    </div>
    <a class="@Active("Dashboard")" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
    <a class="@Active("QueueControl")" asp-controller="Admin" asp-action="QueueControl">Queue Control</a>
    <a class="@Active("Counters")" asp-controller="Admin" asp-action="Counters">Counters</a>
    @if (role == "Admin")
    {
        <a class="@Active("Users")" href="/sims/modules/admin/manage.php?entity=users">Accounts</a>
    }
    <a class="@Active("Reports")" asp-controller="Admin" asp-action="Reports">Reports</a>
    <a class="@Active("Notifications")" asp-controller="Admin" asp-action="Notifications">Notifications</a>
    <a class="@Active("ActivityLogs")" asp-controller="Admin" asp-action="ActivityLogs">Activity</a>
    @if (role == "Admin")
    {
        <a class="@Active("Settings")" asp-controller="Admin" asp-action="Settings">Settings</a>
    }
    <hr />
    <a asp-controller="Home" asp-action="Display" target="_blank">Open Display</a>
</aside>
