@{
    ViewData["Title"] = "Error";
}
<section class="content-shell narrow">
    <div class="panel error-panel reveal-up">
        <img class="panel-logo" src="~/img/smartqueue-logo-icon-only.svg" alt="SmartQueueSystemGUI logo" />
        <h1>Something went wrong</h1>
        <p class="muted">Return to login and try again.</p>
        <a class="btn" asp-controller="Auth" asp-action="Login">Back to Login</a>
    </div>
</section>
